# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=Chatbot Platform
APP_ENV=development
DEBUG=true
VERSION=1.0.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
PORT=8000

# ============================================
# DATABASE - PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
DATABASE_URL=postgresql://chatbot:change-me-in-production@localhost:5432/chatbot_db

# ============================================
# CACHE - Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================
# VECTOR DATABASE - Qdrant
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=document_chunks
QDRANT_API_KEY=

# ============================================
# MESSAGE QUEUE - Kafka
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=chatbot
KAFKA_CONSUMER_GROUP=chatbot-consumers
KAFKA_TOPIC_CHAT_EVENTS=chat.events
KAFKA_TOPIC_AUDIT_EVENTS=audit.events
KAFKA_TOPIC_ANALYTICS_EVENTS=analytics.events

# ============================================
# LLM CONFIGURATION
# ============================================
LLM_PROVIDER=mock
LLM_MODEL=qwen
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# Embedding Model
EMBEDDING_MODEL=mock
EMBEDDING_DIM=384
EMBEDDING_API_KEY=
EMBEDDING_API_URL=

# ============================================
# SECURITY
# ============================================
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

API_KEY_SALT=change-me-in-production
API_KEY_PREFIX=cb_live_
API_KEY_TEST_PREFIX=cb_test_

ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CHAT_REQUESTS=60
RATE_LIMIT_DOCUMENTS_REQUESTS=10
RATE_LIMIT_STREAM_REQUESTS=20

# ============================================
# TOOL CONFIGURATION
# ============================================
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# ============================================
# OBSERVABILITY
# ============================================
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TRACING=true
ENABLE_METRICS=true

# ============================================
# DEPLOYMENT
# ============================================
REGISTRY=localhost:5000
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
KUBERNETES_NAMESPACE=chatbot-platform

# ============================================
# SERVICE URLs
# ============================================
API_GATEWAY_URL=http://localhost:8000
CHAT_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002
ANALYTICS_SERVICE_URL=http://localhost:8003
MODERATION_SERVICE_URL=http://localhost:8004
