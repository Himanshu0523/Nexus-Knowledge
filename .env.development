APP_NAME=Chatbot Platform (Development)
APP_ENV=development
DEBUG=true
VERSION=1.0.0-dev
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1
PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_dev
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_dev_password
DATABASE_URL=postgresql://chatbot:chatbot_dev_password@localhost:5432/chatbot_dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks_dev

KAFKA_BROKERS=localhost:9092
LLM_PROVIDER=mock
LLM_MODEL=qwen

JWT_SECRET=dev_jwt_secret_key_123456789
API_KEY_SALT=dev_api_key_salt_987654321
ALLOWED_ORIGINS=*

API_GATEWAY_URL=http://localhost:8000
CHAT_SERVICE_URL=http://localhost:8001
