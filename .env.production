APP_NAME=Chatbot Platform
APP_ENV=production
DEBUG=false
VERSION=1.0.0
LOG_LEVEL=WARNING
API_PREFIX=/api/v1
PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_prod
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=prod_secure_password_replace_me
DATABASE_URL=postgresql://chatbot:prod_secure_password_replace_me@postgres:5432/chatbot_prod

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=prod_redis_password_replace_me
REDIS_URL=redis://:prod_redis_password_replace_me@redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks_prod

KAFKA_BROKERS=kafka:29092
LLM_PROVIDER=ollama
LLM_MODEL=qwen
LLM_BASE_URL=http://llm-gateway:11434

JWT_SECRET=prod_jwt_super_secret_key_change_before_launch
API_KEY_SALT=prod_api_key_salt_change_before_launch
ALLOWED_ORIGINS=https://app.chatbotplatform.com,https://api.chatbotplatform.com

API_GATEWAY_URL=https://api.chatbotplatform.com
CHAT_SERVICE_URL=http://chat-service:8001
